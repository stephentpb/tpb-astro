---
import "../styles/global.css";
import Nav from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Third Place Books Literary Foundation" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - Third Place Books Literary Foundation</title>
		<meta
  			name="description"
  			content="The Third Place Books Literary Foundation cultivates lifelong readers throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them."
		/>
		<meta property="og:title" content={title} />
		<meta
			property="og:description"
			content="The Third Place Books Literary Foundation cultivates lifelong readers throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them." />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/social.jpg" />
	</head>
	<body class="bg-orange-100 text-orange-950 antialiased">
		<Nav />
		<slot />
		<Footer />
	</body>
</html>