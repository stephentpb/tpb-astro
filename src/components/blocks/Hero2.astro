---
import { Image } from 'astro:assets';
import Button from "../../components/ui/Button.astro";
import heroBg from "../../assets/hero-bg-4.png";
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-end px-6 py-12 text-text-primary antialiased scroll-mt-16 overflow-hidden"
>
  <!-- Background Image - Full width, partial height -->
  <div class="absolute inset-0 -z-10">
    <div class="h-full">
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      class="w-full h-[85vh] object-cover object-center"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Gradient overlay for text readability and fade to bottom -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-transparent"></div>
      <!-- Large Heading - Over the image -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="max-w-5xl mx-auto px-6 text-center">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-heading font-heading-black text-white leading-tight tracking-tight drop-shadow-2xl">
          Nurturing <br />
          <span class="text-primary-light">lifelong readers</span>
        </h1>
      </div>
    </div>
    </div>
  </div>


</section>

  <!-- Overlapping Content Box -->
  <div class="relative w-full max-w-6xl mx-auto -mt-16 md:-mt-24 lg:-mt-32 z-10">
    <div class="bg-white/95 backdrop-blur-sm p-8 md:p-10 lg:p-12 rounded-2xl border border-orange-100/50 shadow-2xl max-w-3xl mx-auto space-y-6">
      
      <div class="space-y-4">
        <p class="font-body text-base sm:text-lg text-text-secondary leading-relaxed">
          The <span class="font-black">Third Place Books Literary Foundation</span> promotes reading throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-2">
        <Button 
          href="#donate" 
          size="lg" 
          class="group inline-flex items-center justify-center font-heading font-heading-semibold bg-primary hover:bg-orange-600 text-white px-8 py-3 rounded-full transition-all duration-300 shadow-lg hover:shadow-primary/25"
        >
          Donate now 
          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </Button>
        
        <a 
          href="/about" 
          class="text-sm font-heading font-heading-medium text-text-secondary hover:text-primary-dark transition-colors px-4 py-2"
        >
          Learn more →
        </a>
      </div>

      <!-- Stats -->
      <div class="flex items-center gap-8 pt-6 border-t border-text-tertiary/20">
        <div>
          <span class="block text-2xl font-heading font-heading-bold text-primary-dark">15K+</span>
          <span class="text-xs font-heading font-heading-light text-text-secondary uppercase tracking-wider">Books donated</span>
        </div>
        <div>
          <span class="block text-2xl font-heading font-heading-bold text-primary-dark">500+</span>
          <span class="text-xs font-heading font-heading-light text-text-secondary uppercase tracking-wider">School author visits</span>
        </div>
      </div>
    </div>
  </div>

<style>
  /* Smooth scroll indicator animation */
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-8px); }
  }
  
  .animate-bounce {
    animation: bounce 2s ease-in-out infinite;
  }

  /* Ensure the image is visible below the content box */
  section {
    min-height: 120vh;
  }
</style>