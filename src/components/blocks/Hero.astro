---
import { Image } from 'astro:assets';
import { FaArrowRight } from 'react-icons/fa';
import heroImage from "../../assets/hero.png";
import Button from "../../components/ui/Button.astro";
---

<!-- HERO -->
    <section
    id="hero"
    class="relative min-h-screen flex items-center justify-center px-6 text-zinc-800 antialiased
          bg-[url('/hero-bg.jpg')] bg-cover bg-center scroll-mt-16"
  >
    <!-- Gradient overlay -->
    <div class="absolute inset-0"></div>

    <!-- Content -->
    <div class="relative max-w-6xl text-center space-y-6 fade-up md:flex items-center">
    <div>
      <Image
        src={heroImage}
        alt="Hero image"
        class="rounded-xl"
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 1200px"
      />
    </div>
    <div class="md:text-left bg-white p-5">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
          5/12 Álvaro Enrigue
        </h2>
        <p class="text-lg md:text-xl text-zinc-600">
          presenting his new book, <i>Now I Surrender,</i> with TPB events manager Spencer Ruchti
        </p>
        <Button href="#features">RSVP now →</Button>
      </div>
    </div>
  </section>