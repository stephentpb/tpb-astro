---
// src/components/Grid.astro
interface Props {
  cols?: 2 | 3 | 4;
  class?: string;
}

const { cols = 3, class: className = '' } = Astro.props;

// Map column count to Tailwind grid classes
const gridCols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<div class={`grid grid-cols-1 gap-6 ${gridCols[cols]} ${className}`}>
  <slot />
</div>