---
// src/components/GridCard.astro
interface Props {
  title?: string;
  description?: string;
  badge?: string;
  image?: string;
  imagePosition?: 'top' | 'bottom' | 'none';
  variant?: 'default' | 'featured' | 'compact';
  class?: string;
}

const { 
  title, 
  description, 
  badge,
  image,
  imagePosition = 'top',
  variant = 'default',
  class: className = '' 
} = Astro.props;

const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
const hasImage = Astro.slots.has('image') || image;

// Variant configurations
const variantStyles = {
  default: {
    wrapper: 'border border-primary-light/80 shadow-sm hover:shadow-lg hover:border-primary-light',
    header: 'border-b border-primary-light bg-primary-light/30',
    footer: 'border-t border-gray-100 bg-gray-50/50'
  },
  featured: {
    wrapper: 'border-2 border-amber-200 shadow-md hover:shadow-xl hover:border-amber-300 ring-2 ring-amber-500/10',
    header: 'border-b border-amber-200 bg-gradient-to-r from-amber-50 to-amber-50/50',
    footer: 'border-t border-amber-100 bg-amber-50/30'
  },
  compact: {
    wrapper: 'border border-gray-200/80 shadow-sm hover:shadow-md',
    header: 'border-b border-gray-100 bg-gray-50/50 p-4',
    footer: 'border-t border-gray-100 bg-gray-50/50 p-4'
  }
};

const styles = variantStyles[variant] || variantStyles.default;
---

<div
  class={`
    flex flex-col h-full 
    rounded-xl 
    transition-all duration-300 
    hover:-translate-y-1
    overflow-hidden 
    bg-white
    ${styles.wrapper}
    ${className}
  `}
>
  {/* Image Section */}
  {hasImage && imagePosition === 'top' && (
    <div class="relative overflow-hidden bg-gray-100">
      <slot name="image">
        {image && (
          <img 
            src={image} 
            alt={title || 'Card image'} 
            class="w-full h-48 object-cover transition-transform duration-500 hover:scale-105"
            loading="lazy"
          />
        )}
      </slot>
    </div>
  )}

  {/* Header Section */}
  {(hasHeader || title || description) && (
    <div class={`p-6 ${variant !== 'compact' ? 'space-y-2' : 'space-y-1'} ${styles.header}`}>
      <slot name="header">
        <div class="space-y-1.5">
          {title && (
            <div class="flex items-start gap-2">
              <h3 class={`
                font-semibold text-gray-900 leading-tight
                ${variant === 'compact' ? 'text-base' : 'text-lg sm:text-lg'}
              `}>
                {title}
              </h3>
              {badge && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 whitespace-nowrap flex-shrink-0">
                  {badge}
                </span>
              )}
            </div>
          )}
          {description && (
            <p class={`
              text-gray-600 leading-relaxed
              ${variant === 'compact' ? 'text-xs' : 'text-sm'}
            `}>
              {description}
            </p>
          )}
        </div>
      </slot>
    </div>
  )}

  {/* Body Section */}
  <div class={`
    flex-1 
    ${variant === 'compact' ? 'p-4' : 'p-6'}
  `}>
    <div class="text-gray-700 leading-relaxed space-y-2">
      <slot />
    </div>
  </div>

  {/* Image Section (bottom) */}
  {hasImage && imagePosition === 'bottom' && (
    <div class="relative overflow-hidden bg-gray-100">
      <slot name="image">
        {image && (
          <img 
            src={image} 
            alt={title || 'Card image'} 
            class="w-full h-48 object-cover transition-transform duration-500 hover:scale-105"
            loading="lazy"
          />
        )}
      </slot>
    </div>
  )}

  {/* Footer Section */}
  {hasFooter && (
    <div class={`
      ${variant === 'compact' ? 'p-4 pt-3' : 'p-6 pt-4'}
      ${styles.footer}
    `}>
      <div class="flex flex-wrap items-center gap-3">
        <slot name="footer" />
      </div>
    </div>
  )}
</div>