---
import Para from "../../components/ui/Para.astro";
const { id, type = "section", variant = "primary" } = Astro.props;

const baseStyles = "px-6 md:px-24 pt-6 scroll-mt-16";
const variants = {
  primary: "bg-light-bg text-text",
  light: "big-white text-text",
  dark: "bg-text text-light-bg"
};

const classes = `${baseStyles} ${variants[variant]}`;
---

<section id={id}  type={type} class={classes}>
  <div class="max-w-3xl mx-auto space-y-6">
    <h1 class="m-0">
      <slot name="title" />
    </h1>
  </div>
</section>