---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/blocks/Hero.astro";
import Button from "../components/ui/Button.astro";
import Events from "../components/blocks/Events.astro";
import Booklists from "../components/blocks/Booklists.astro";
import Section from "../components/layout/Section.astro";
import Grid from '../components/layout/Grid.astro';
import GridCard from '../components/layout/GridCard.astro';
---

<Layout  title="Home">
	<Hero />

  <!-- ABOUT -->
  <Section id="about">
    <span slot="header">Fostering a love of reading</span>
      The Third Place Books Literary Foundation brings books and authors to the community. We have four main programs that support our core mission: cultivating lifelong readers throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them.
  </Section>

  <!-- FEATURES -->
   <div class="bg-black">
  <section id="features" class="px-6 py-24 bg-primary-dark/50 text-text-tertiary scroll-mt-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-primary text-center">
        What we do
      </h2>

      <Grid cols={4}>
        <GridCard title="Book Donations">
            <p>Donating books to low income schools and organizations that are supporting literacy outcomes in our community.</p>
        </GridCard>

        <GridCard title="Author Events">
            <p>Free events held in our stores and at schools or community hubs that connect readers directly to authors.</p>
        </GridCard>

        <GridCard title="Book Fairs">
            <p>Bringing a curated selection of books to local schools and community organizations.</p>
        </GridCard>

        <GridCard title="Building Community">
            <p>Creating a third place out in the local community with pop-up book sales, community events and author presentations.</p>
        </GridCard>
      </Grid>
    </div>
  </section>
</div>

  <!-- CTA -->
  <section id="cta" class="px-6 py-32 bg-black text-center text-text-tertiary scroll-mt-16">
    <div class="max-w-2xl mx-auto space-y-6">
      <h2 class="text-primary text-center">Sign up to our newsletter!</h2>
      <Button href="#">Get in touch</Button>
    </div>
  </section>
