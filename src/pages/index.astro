---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { Image } from "astro:assets";
import { FaArrowRight } from 'react-icons/fa';
import Button from "../components/Button.astro";
import Events from "../components/Events.astro";
---

<Layout>
	<Hero />

  <!-- ABOUT -->
  <section id="about" class="px-6 py-24 bg-zinc-900 text-zinc-100 scroll-mt-16">
    <div class="max-w-3xl mx-auto space-y-6">
        <h2 class="text-3xl font-semibold">Why this exists</h2>
        <p class="text-zinc-400">
          This section explains the purpose of the site in a clear,
          human way: no fluff, no jargon.
        </p>
    </div>
  </section>

  <Events />

  <!-- FEATURES -->
  <section id="features" class="px-6 py-24 bg-zinc-950 text-zinc-100 scroll-mt-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-semibold text-center mb-12">
        What you get
      </h2>

      <div class="grid gap-8 md:grid-cols-3">
        {[
          "Fast & lightweight",
          "Clean structure",
          "Easy to deploy",
        ].map(feature => (
          <div class="rounded-xl bg-zinc-900 p-6">
            <h3 class="font-medium mb-2">{feature}</h3>
            <p class="text-sm text-zinc-400">
              Short explanation of this benefit.
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" class="px-6 py-32 bg-zinc-900 text-center text-zinc-100 scroll-mt-16">
    <div class="max-w-2xl mx-auto space-y-6">
      <h2 class="text-4xl font-semibold">Ready to start?</h2>
      <Button href="#">Get in touch</Button>
    </div>
  </section>
