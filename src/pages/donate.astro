---
import { Image } from 'astro:assets';
import DonateImg from "../assets/donate-img.jpeg";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/layout/Section.astro";
import Header from '../components/layout/Header.astro';
import Grid from '../components/layout/Grid.astro';
import GridCard from '../components/layout/GridCard.astro';
import DonationList from '../components/layout/DonationList.astro';
import Para from '../components/ui/Para.astro'
---

<Layout title="Donate">
    <div class="py-24">
        <section class="px-24 py-6 scroll-mt-16 big-white text-text">
            <div class="flex flex-col md:flex-row justify-between items-center gap-10 w-full">
                <div class="space-y-4 w-full md:w-2/5">
                    <h1 slot="header" class="text-center md:text-left">Donate today!</h1>
                    <p class="text-center md:text-left mx-auto">
                        The Third Place Books Literary Foundation cultivates lifelong readers throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them.
                    </p>
                    <div class="flex justify-center">
                        <script type="module" src="https://donorbox.org/widgets.js" async></script><dbox-widget campaign="tpb" type="popup" button-label="Donate now" button-type="regular" button-color="#9b3817" button-size="large" regular-position="center" show-icon=""></dbox-widget>
                    </div>
                </div>
                <div class="w-full md:w-3/5">
                    <Image
                    src={DonateImg}
                    alt=""
                    aria-hidden="true"
                    class="w-full h-full object-cover object-center lg:pt-0 border border-text rounded-2xl"
                    widths={[640, 1024, 1920]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    />
                </div>
            </div>
        </section>
        <section class="max-w-3xl mx-auto px-10">
            <div class="text-center text-3xl font-sans font-bold mt-10 mb-5">
                By donating today you are helping to directly support our programs.
            </div>

            <DonationList variant="blue">
                <span slot="amount">$25</span>
                <span slot="description">
                    allows us to donate one hardcover book that a community member will be able to take home.
                </span>
            </DonationList>

            <DonationList variant="green">
                <span slot="amount">$50</span>
                <span slot="description">
                    lets us donate 3 (or more!) books to students attending a Title I school.
                </span>
            </DonationList>

            <DonationList variant="primary">
                <span slot="amount">$100</span>
                <span slot="description">
                    supports our school author visit program, helping us to bring more authors into local area schools and community spaces.
                </span>
            </DonationList>

            <DonationList variant="primaryDark">
                <span slot="amount">$500</span>
                <span slot="description">
                    supports our author event program, letting us host more authors events in our stores that are free for community members to attend. 
                </span>
            </DonationList>

            <DonationList variant="blue">
                <span slot="amount">$1,000</span>
                <span slot="description">
                    is enough for us to donate all the books in a teacher's wishlist.
                </span>
            </DonationList>

            <DonationList variant="green">
                <span slot="amount">$5,000</span>
                <span slot="description">
                    would allow us to give a book to every student attending a school author visit.  
                </span>
            </DonationList>

            <DonationList variant="red">
                <span slot="amount">$15,000</span>
                <span slot="description">
                    enables us to host a free book fair, giving at least one book to every child and making a donation of books to the school (or community organizations) library. 
                </span>
            </DonationList>

            <div class="text-center text-3xl font-sans font-bold mt-10 mb-5">
                Donate today and help to foster lifelong readers
            </div>

            <div class="flex justify-center">
                <script type="module" src="https://donorbox.org/widgets.js" async></script><dbox-widget campaign="tpb" type="popup" button-label="Donate now" button-type="regular" button-color="#7d8bc0" button-size="large" regular-position="center" show-icon=""></dbox-widget>
            </div>
        </section>

        <Section variant="light">
            <div class="flex justify-center">
            <div class="bg-light-bg max-w-4xl p-8 md:p-10 lg:p-12 rounded-2xl border md:border-text-100/50 space-y-6">
                <h2>For check donations</h2>
                <p class="text-lg">
                Please make your check payable to “Friends of Third Place Commons” and in the memo line write “Third Place Books Literary Foundation”.
                </p>
                <p>
                    <ul class="text-lg">
                        <li>
                            Mailing address:
                        </li>
                        <li>
                            Third Place Books Literary Foundation
                        </li>
                        <li>
                            c/o Third Place Books
                        </li>
                        <li>
                            17171 Bothell Way NE, A200
                        </li>
                        <li>
                            Lake Forest Park, WA 98155
                        </li>
                    </ul>
                </p>
                <p>
                    <span class="text-sm italic">
                        The Third Place Literary Foundation is fiscally sponsored by <a href="https://www.thirdplacecommons.org/">Third Place Commons</a>. Third Place Commons is a registered 501(c)(3) nonprofit organization. All donations are tax-deductible to the extent allowed by law. Federal Tax ID (EIN): 91-2054524.
                    </span>
                </p>
            </div>
            </div>
        </Section>
    </div>
</Layout>

