---
import { Image } from 'astro:assets';
import DonateImg from "../assets/donate-img.jpeg";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/layout/Section.astro";
import Grid from '../components/layout/Grid.astro';
import GridCard from '../components/layout/GridCard.astro';
import Para from '../components/ui/Para.astro'
---

<Layout title="Donate">
    <div class="py-24">
        <section class="px-24 py-6 scroll-mt-16 big-white text-text">
            <div class="flex flex-col md:flex-row justify-between items-center gap-10 w-full">
                <div class="space-y-4 w-full md:w-2/5">
                    <h1 slot="header" class="text-center md:text-left">Donate today!</h1>
                    <p class="text-center md:text-left mx-auto">
                        The Third Place Books Literary Foundation cultivates lifelong readers throughout greater Seattle by ensuring access to books and meaningful experiences with the authors who write them.
                    </p>
                    <div class="flex justify-center">
                        <script type="module" src="https://donorbox.org/widgets.js" async></script><dbox-widget campaign="tpb" type="popup" button-label="Donate" button-type="regular" button-color="#88b27a" button-size="large" regular-position="center" show-icon=""></dbox-widget>
                    </div>
                </div>
                <div class="w-full md:w-3/5">
                    <Image
                    src={DonateImg}
                    alt=""
                    aria-hidden="true"
                    class="w-full h-full object-cover object-center lg:pt-0 border border-text rounded-2xl"
                    widths={[640, 1024, 1920]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    />
                </div>
            </div>
        </section>
        <Section variant="light">
            <h2 class="text-center mt-10">
                By donating today you are helping to directly support our programs.
            </h2>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-blue font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$25</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">allows us to donate one hardcover book that a community member will be able to take home.
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-green font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$50</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    lets us donate 3 (or more!) books to students attending a Title I school.
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-primary font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$100</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    supports our school author visit program, helping us to bring more authors into local area schools and community spaces.
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-primary-dark font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$500</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    supports our author event program, letting us host more authors events in our stores that are free for community members to attend. 
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-blue font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$1,000</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    is enough for us to donate all the books in a teachers wishlist.
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-green font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$5,000</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    would allow us to give a book to every student attending a school author visit.  
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-3xl bg-red font-sans text-light-bg py-10 rounded-full w-1/3 md:w-1/4 text-center transition-all duration-300 hover:-translate-y-1 overflow-hidden">$15,000</div>
                <div class="text-base md:text-xl w-2/3 md:w-3/4">
                    enables us to host a free book fair, giving at least one book to every child and making a donation of books to the school (or community organizations) library. 
                </div>
            </div>
            <div class="flex justify-center">
                <script type="module" src="https://donorbox.org/widgets.js" async></script><dbox-widget campaign="tpb" type="popup" button-label="Donate" button-type="regular" button-color="#7d8bc0" button-size="large" regular-position="center" show-icon=""></dbox-widget>
            </div>
        </Section>

        <Section variant="light">
            <div class="flex justify-center">
            <div class="bg-light-bg max-w-4xl p-8 md:p-10 lg:p-12 rounded-2xl border md:border-text-100/50 space-y-6">
                <h2>For check donations</h2>
                <p class="text-lg">
                Please make your check payable to “Friends of Third Place Commons” and in the memo line write “Third Place Books Literary Foundation”.
                </p>
                <p>
                    <ul class="text-lg">
                        <li>
                            Mailing address:
                        </li>
                        <li>
                            Third Place Books Literary Foundation
                        </li>
                        <li>
                            c/o Third Place Books
                        </li>
                        <li>
                            17171 Bothell Way NE, A200
                        </li>
                        <li>
                            Lake Forest Park, WA 98155
                        </li>
                    </ul>
                </p>
                <p>
                    <span class="text-sm italic">
                        The Third Place Literary Foundation is fiscally sponsored by Third Place Commons. Third Place Commons is a registered 501(c)(3) nonprofit organization. All donations are tax-deductible to the extent allowed by law. Federal Tax ID (EIN): 91-2054524.
                    </span>
                </p>
            </div>
            </div>
        </Section>
    </div>
</Layout>

